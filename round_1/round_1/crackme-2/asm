    if (sscanf(&input[limit], "%d", &last_digit) != 1) {
        return 0;
    }

    // 4. Final Verdict
    // Corresponds to: cmp %ebx, 0xc(%rsp) + sete %al
    return (expected_digit == last_digit);
}

