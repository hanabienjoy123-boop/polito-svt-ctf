int validate_key(char *input) {
    int sum = 0;
    int len = strlen(input);
    int limit = len - 1; // Loop for the first 15 characters (N-1)

    // 1. Loop and Sum Section
    for (int i = 0; i < limit; i++) {
        // Check if current character is a digit ('0'-'9')
        // Corresponds to __ctype_b_loc check in assembly
        if (!isdigit(input[i])) {
            return 0; // Failure if non-digit character found
        }
        
        // Sum up the numeric values
        // Corresponds to: lea -0x30(%rbx,%rcx,1), %ebx
        sum += (input[i] - '0');
    }

    // 2. Modulo Calculation
    // Corresponds to: and $0xf, %ebx
    int expected_digit = sum % 16;

    // 3. Read the Last Digit
    // Corresponds to: sscanf(last_char_addr, "%d", &last_digit)
